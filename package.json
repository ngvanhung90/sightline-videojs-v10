{
  "name": "sightline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "node apps/preview/deploy.mjs",
    "deploy:vercel": "npx --yes vercel@64 build && npx --yes vercel@64 deploy --prebuilt",
    "deploy:netlify": "npx --yes netlify-cli@27 deploy --build",
    "deploy:cloudflare": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name sightline",
    "lint": "eslint src/player.ts src/video/skin.tsx src/video/icons.tsx apps/demo --max-warnings 0",
    "build:workbench": "vite build --config vite.workbench.config.ts"
  },
  "dependencies": {
    "@videojs/core": "10.3.0",
    "@videojs/react": "10.3.0",
    "cn": "0.4.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@heroicons/react": "2.2.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@videojs/mux-video": "10.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.2",
    "vite": "8.3.7",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.2"
  }
}
